# 目标平台 + 机型。workflow 会先写这一段再 make defconfig。
# 符号格式是 CONFIG_TARGET_<board>_<subtarget>_DEVICE_<profile>（"Target Profile" 那个 choice）。
# 不要写成 CONFIG_TARGET_DEVICE_...，那是 TARGET_MULTI_PROFILE 打开后才存在的符号。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_ruijie_rg-x30e-stock=y
